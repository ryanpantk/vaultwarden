Set up your company password manager — {{{org_name}}}
<!---------------->
<!DOCTYPE html>
<html lang="en" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
  <meta name="x-apple-disable-message-reformatting">
  <title>Set up your company password manager</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!--[if gte mso 9]>
  <xml>
    <o:OfficeDocumentSettings>
      <o:AllowPNG/>
      <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
  </xml>
  <![endif]-->
  <style>
    html, body { margin: 0 !important; padding: 0 !important; min-height: 100% !important; width: 100% !important; -webkit-font-smoothing: antialiased; }
    * { -ms-text-size-adjust: 100%; box-sizing: border-box; }
    #outlook a { padding: 0; }
    table, td, th { mso-table-lspace: 0 !important; mso-table-rspace: 0 !important; border-collapse: collapse; }
    img { border: 0; outline: 0; line-height: 100%; text-decoration: none; -ms-interpolation-mode: bicubic; }
    a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }

    .cta-btn:hover { background-color: #141852 !important; }

    @media (max-width: 620px) {
      .email-container { width: 100% !important; }
      .email-padding { padding: 24px 20px !important; }
      .info-box-padding { padding: 14px 14px !important; }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #F4F4F8; font-family: 'Inter', Arial, sans-serif; color: #1A1A2E;">

  <!-- Outer wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="background-color: #F4F4F8;">
    <tr>
      <td align="center" valign="top" style="padding: 28px 16px 48px 16px;">

        <!-- Email card container -->
        <table class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
               style="width: 600px; max-width: 600px; background-color: #ffffff; border-radius: 14px; border: 1px solid #E2E2EC; overflow: hidden; box-shadow: 0 2px 12px rgba(28,33,102,0.07);">

          <!-- ── Logo header ── -->
          <tr>
            <td class="email-padding" align="center" style="padding: 32px 48px 28px 48px; background-color: #ffffff; border-bottom: 1px solid #E2E2EC;">
              <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                <tr>
                  <td valign="middle" style="padding-right: 10px;">
                    <!-- StrongKeep shield logo (SVG) -->
                    <img src="https://cdn.prod.website-files.com/674fd2a7eefe8c32bdde6afe/6763de3785b9735b220b7770_header_logo_strongkeep.png"
                         width="160" height="auto" alt="StrongKeep"
                         style="display: block; width: 160px; height: auto; border: 0;" />
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ── Email body ── -->
          <tr>
            <td class="email-padding" style="padding: 36px 48px 36px 48px;">

              <!-- Intro -->
              <p style="font-size: 15px; line-height: 1.7; color: #444; margin: 0 0 20px 0;">
                Your IT admin at <strong style="color: #1A1A2E;">{{{org_name}}}</strong> has asked you to create an account on the company password manager.
                This is a company requirement — it takes only a few minutes and keeps your work accounts secure.
              </p>

              <!-- ── Why it matters box ── -->
              <table class="info-box-padding" width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
                     style="margin: 0 0 20px 0;">
                <tr>
                  <td style="background-color: #EEF0FF; border: 1px solid #D0D3F0; border-radius: 10px; padding: 16px 18px;">

                    <!-- Label -->
                    <p style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #1C2166; margin: 0 0 12px 0;">Why this matters</p>

                    <!-- Row 1 -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 10px;">
                      <tr>
                        <td width="24" valign="top" style="padding-top: 2px; padding-right: 10px;">
                          <!-- Shield icon -->
                          <img src="https://cdn.prod.website-files.com/674fd2a7eefe8c32bdde6afe/6763de3785b9735b220b7770_header_logo_strongkeep.png"
                               width="16" height="16" alt="" aria-hidden="true"
                               style="display: none;" />
                          <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                            <tr><td style="font-size: 16px; line-height: 1;">🛡️</td></tr>
                          </table>
                        </td>
                        <td valign="top">
                          <p style="font-size: 13.5px; font-weight: 500; color: #1C2166; margin: 0; line-height: 1.55;">
                            Reused or weak passwords are the #1 cause of account breaches. A password manager generates and stores a unique, strong password for every account.
                          </p>
                        </td>
                      </tr>
                    </table>

                    <!-- Row 2 -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="24" valign="top" style="padding-top: 2px; padding-right: 10px;">
                          <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                            <tr><td style="font-size: 16px; line-height: 1;">🔒</td></tr>
                          </table>
                        </td>
                        <td valign="top">
                          <p style="font-size: 13.5px; font-weight: 500; color: #1C2166; margin: 0; line-height: 1.55;">
                            You only need to remember one password — your master password — and the vault handles the rest.
                          </p>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- ── Master password warning box ── -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
                     style="margin: 0 0 20px 0;">
                <tr>
                  <td style="background-color: #FFFBEB; border: 1px solid #FCD34D; border-radius: 10px; padding: 14px 16px;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="28" valign="top" style="padding-top: 2px; padding-right: 10px;">
                          <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                            <tr><td style="font-size: 17px; line-height: 1;">⚠️</td></tr>
                          </table>
                        </td>
                        <td valign="top">
                          <p style="font-size: 13px; font-weight: 700; color: #92400E; margin: 0 0 4px 0; line-height: 1.4;">
                            Write down your master password and keep it somewhere safe.
                          </p>
                          <p style="font-size: 13px; color: #92400E; margin: 0; line-height: 1.6;">
                            Your master password cannot be reset by anyone — not even your IT admin. If you lose it, access to your vault cannot be recovered. Store it somewhere secure, such as a personal notebook kept at home.
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Intro to steps -->
              <p style="font-size: 15px; line-height: 1.7; color: #444; margin: 0 0 16px 0;">
                Once your account is created, follow these steps to start using the password manager in your browser:
              </p>

              <!-- ── Steps ── -->
              <!-- Step 1 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 14px;">
                <tr>
                  <td width="36" valign="top">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="24" height="24" align="center" valign="middle"
                            style="width: 24px; height: 24px; border-radius: 50%; background-color: #1C2166; color: #ffffff; font-size: 12px; font-weight: 700; font-family: 'Inter', Arial, sans-serif; text-align: center; line-height: 24px;">
                          1
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td valign="top" style="padding-left: 4px;">
                    <p style="font-size: 13.5px; color: #1A1A2E; margin: 0; line-height: 1.6;">
                      <strong>Create your account</strong> using the button below. Use your work email and choose a strong master password.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Step 2 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 14px;">
                <tr>
                  <td width="36" valign="top">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="24" height="24" align="center" valign="middle"
                            style="width: 24px; height: 24px; border-radius: 50%; background-color: #1C2166; color: #ffffff; font-size: 12px; font-weight: 700; font-family: 'Inter', Arial, sans-serif; text-align: center; line-height: 24px;">
                          2
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td valign="top" style="padding-left: 4px;">
                    <p style="font-size: 13.5px; color: #1A1A2E; margin: 0; line-height: 1.6;">
                      <strong>Install the browser extension.</strong> After logging in, go to <em>Settings → Browser Extension</em> and install it for your browser (Chrome, Firefox, Edge, or Safari).
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Step 3 -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin-bottom: 20px;">
                <tr>
                  <td width="36" valign="top">
                    <table cellpadding="0" cellspacing="0" border="0" role="presentation">
                      <tr>
                        <td width="24" height="24" align="center" valign="middle"
                            style="width: 24px; height: 24px; border-radius: 50%; background-color: #1C2166; color: #ffffff; font-size: 12px; font-weight: 700; font-family: 'Inter', Arial, sans-serif; text-align: center; line-height: 24px;">
                          3
                        </td>
                      </tr>
                    </table>
                  </td>
                  <td valign="top" style="padding-left: 4px;">
                    <p style="font-size: 13.5px; color: #1A1A2E; margin: 0 0 6px 0; line-height: 1.6;">
                      <strong>Set the correct server domain</strong> when logging into the extension. Under <em>Self-hosted</em>, enter:
                    </p>
                    <p style="margin: 0;">
                      <span style="display: inline-block; background-color: #EEF0FF; color: #1C2166; font-size: 12.5px; font-weight: 600; padding: 3px 10px; border-radius: 5px; font-family: 'Courier New', Courier, monospace; letter-spacing: 0.01em;">
                        https://vaultwarden.strongkeep.com
                      </span>
                    </p>
                  </td>
                </tr>
              </table>

              <!-- ── CTA Button ── -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin: 8px 0 24px 0;">
                <tr>
                  <td align="center">
                    <a href="{{{url}}}" class="cta-btn" data-testid="invite" clicktracking="off" target="_blank"
                       style="display: inline-block; background-color: #1C2166; color: #ffffff; text-decoration: none; padding: 13px 36px; border-radius: 9px; font-size: 14px; font-weight: 600; font-family: 'Inter', Arial, sans-serif; letter-spacing: 0.01em; line-height: 1;">
                      Create My Account &rarr;
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Help note -->
              <p style="font-size: 13px; line-height: 1.7; color: #666; text-align: center; margin: 0 0 0 0;">
                If you run into any trouble, contact your IT admin directly.
              </p>

            </td>
          </tr>

          <!-- ── Footer ── -->
          <tr>
            <td style="padding: 18px 48px 24px 48px; border-top: 1px solid #E2E2EC; text-align: center;">
              <p style="font-size: 12px; color: #aaaaaa; line-height: 1.7; margin: 0 0 6px 0;">
                If you're unsure whether this email is legitimate, do not click the link above.<br>
                Contact your IT admin directly to verify.
              </p>
              <p style="font-size: 12px; color: #aaaaaa; line-height: 1.7; margin: 0;">
                Need help? <a href="mailto:support@strongkeep.com" style="color: #888888; text-decoration: none;">support@strongkeep.com</a>
              </p>
            </td>
          </tr>

        </table>
        <!-- /Email card -->

      </td>
    </tr>
  </table>

</body>
</html>
